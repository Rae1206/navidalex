{
  "id": "root",
  "cloned_from": {
    "name": "p5-forest",
    "version": "0.1.16"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "p5-chrome-forest"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "p5-spaces-forest"
              },
              "size": {
                "px": 120
              },
              "min": 80
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "p5-agents-forest",
                "props": {
                  "fill": true
                }
              },
              "size": {
                "px": 260
              },
              "min": 80
            },
            {
              "id": "pi-agents",
              "type": "block",
              "content": {
                "mod": "pi-agents",
                "props": {
                  "forestRail": true
                }
              },
              "size": {
                "weight": 2
              },
              "min": 140
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "p5-chrome-forest",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 92
          }
        }
      ],
      "size": {
        "px": 44
      },
      "min": 44,
      "max": 480,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "p5-tabs-forest"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "views",
              "type": "stack",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "p5-pane-chat-forest",
                          "props": {
                            "stack": "views",
                            "other": "chat"
                          }
                        },
                        "reveal": "always",
                        "height": 36,
                        "position": "top"
                      },
                      "background": "#00000000",
                      "border": {
                        "width": 0,
                        "color": "#000000"
                      },
                      "focus": {
                        "width": 0,
                        "color": "#5CE08A"
                      },
                      "radius": 0,
                      "gap": 12,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "chat",
                  "type": "row",
                  "resizable": false,
                  "children": [
                    {
                      "id": "festive-left",
                      "type": "block",
                      "size": {
                        "weight": 1
                      },
                      "content": {
                        "mod": "festive-rail",
                        "props": {
                          "side": "left",
                          "stack": "views",
                          "self": "chat"
                        }
                      }
                    },
                    {
                      "id": "chat-body",
                      "type": "block",
                      "size": {
                        "px": 912
                      },
                      "content": {
                        "mod": "any-chat",
                        "props": {
                          "stack": "views",
                          "self": "chat",
                          "other": "main",
                          "block": "chat-body"
                        }
                      }
                    },
                    {
                      "id": "festive-right",
                      "type": "block",
                      "size": {
                        "weight": 1
                      },
                      "content": {
                        "mod": "festive-rail",
                        "props": {
                          "side": "right",
                          "stack": "views",
                          "self": "chat"
                        }
                      }
                    }
                  ]
                }
              ],
              "active": "chat"
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "viewer",
                      "type": "block",
                      "content": {
                        "mod": "file-view",
                        "props": {
                          "stack": "panel-body",
                          "self": "viewer",
                          "changes": "changes"
                        }
                      }
                    },
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "inbox",
                      "type": "block",
                      "content": {
                        "mod": "needs-inbox"
                      }
                    },
                    {
                      "id": "recap",
                      "type": "block",
                      "content": {
                        "mod": "recap"
                      }
                    },
                    {
                      "id": "odd",
                      "type": "block",
                      "content": {
                        "mod": "odd-tasks"
                      }
                    },
                    {
                      "id": "ci",
                      "type": "block",
                      "content": {
                        "mod": "ci-board"
                      }
                    },
                    {
                      "id": "blueprint",
                      "type": "block",
                      "content": {
                        "mod": "blueprint",
                        "props": {
                          "panel": true
                        }
                      }
                    },
                    {
                      "id": "agenttrail",
                      "type": "block",
                      "content": {
                        "mod": "agenttrail"
                      }
                    },
                    {
                      "id": "git",
                      "type": "block",
                      "content": {
                        "mod": "git-graph"
                      }
                    }
                  ],
                  "active": "viewer",
                  "header": {
                    "content": {
                      "mod": "panel-tabs",
                      "props": {
                        "stack": "panel-body",
                        "panel": "panel",
                        "tabs": [
                          [
                            "viewer",
                            "Viewer"
                          ],
                          [
                            "files",
                            "Files"
                          ],
                          [
                            "changes",
                            "Changes"
                          ],
                          [
                            "inbox",
                            "Inbox"
                          ],
                          [
                            "recap",
                            "Recap"
                          ],
                          [
                            "odd",
                            "ODD"
                          ],
                          [
                            "ci",
                            "CI"
                          ],
                          [
                            "blueprint",
                            "Plan"
                          ],
                          [
                            "agenttrail",
                            "Trail"
                          ],
                          [
                            "git",
                            "Git"
                          ]
                        ]
                      }
                    },
                    "height": 34
                  }
                }
              ],
              "size": {
                "px": 388
              },
              "min": 280,
              "max": 1100
            },
            {
              "id": "skillshare-panel",
              "type": "column",
              "children": [
                {
                  "id": "skillshare-body",
                  "type": "block",
                  "content": {
                    "mod": "skillshare"
                  }
                }
              ],
              "size": {
                "px": 400
              },
              "min": 380,
              "max": 720,
              "hidden": true
            }
          ],
          "padding": [
            10,
            12
          ],
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "p5-status-forest"
          },
          "size": {
            "px": 30
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "assets/forest-wallpaper.jpg",
    "fit": "cover"
  },
  "theme": "persona5-forest",
  "terminal_padding": [
    10,
    12
  ],
  "terminal_opacity": 0.75,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/persona5.svg"
}
